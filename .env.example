# =============================================================================
# BnaSalud — Variables de entorno del backend público (`app/`)
# -----------------------------------------------------------------------------
# Copia este archivo a .env para desarrollo:
#   Windows:     copy .env.example .env
#   Linux/macOS: cp .env.example .env
# En el hosting (Railway/Render) estas mismas variables se definen en el panel.
# NUNCA subas el archivo .env al repositorio (contiene secretos).
# =============================================================================

# --- Entorno -----------------------------------------------------------------
# "development" en tu máquina; el Dockerfile de despliegue fija "production".
# Con production el backend NO arranca si falta una credencial, si el JWT_SECRET
# es el de ejemplo o si CORS_ORIGINS sigue en "*".
ENVIRONMENT="development"

# --- Base de datos (Supabase) ------------------------------------------------
# El backend lee y escribe los datos a través del cliente de Supabase.
# Son las dos variables imprescindibles: sin ellas la API arranca pero
# todas las consultas a datos fallan.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
# En desarrollo sirve la anon_key. En producción (Railway) usa la
# service_role_key SOLO en el backend: nunca en el repositorio ni en el
# frontend de Vercel.
SUPABASE_KEY="TU-ANON-KEY"

# Conexión directa a PostgreSQL. No la usa el portal; solo scripts/restore_db.py
# y docker-compose.yml (Evolution API). Opcional.
# DATABASE_URL="postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres"

# --- IA / RAG (opcional) -----------------------------------------------------
GOOGLE_API_KEY=""

# --- CORS --------------------------------------------------------------------
# Dominios autorizados separados por coma. Obligatorio en producción y sin "*".
# CORS_ORIGINS="https://tu-portal.vercel.app,http://localhost:5173"
CORS_ORIGINS="*"
# Opcional: regex para los previews de Vercel (cada despliegue tiene su URL).
# CORS_ORIGIN_REGEX="^https://[a-z0-9-]+\.vercel\.app$"

# --- Autenticación (JWT) -----------------------------------------------------
# En producción se exige un secreto propio de 32+ caracteres:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="cambiar-en-produccion-por-un-secreto-largo"
JWT_ALGORITHM="HS256"
JWT_EXPIRACION_MINUTOS=480

# --- Restablecimiento de contraseña del paciente ----------------------------
# Vigencia del código de 6 dígitos que se envía por correo.
# Con ENVIRONMENT=development y sin SMTP, la API devuelve el código en
# `codigo_desarrollo` para poder probar el flujo; en producción nunca.
RECUPERACION_EXPIRACION_MINUTOS=15

# --- Tareas programadas ------------------------------------------------------
# Recordatorios de cita cada hora. Requiere proceso siempre encendido
# (Railway/Render). Pon false en plataformas serverless.
ENABLE_SCHEDULER=true

# Zona horaria del contenedor (Render). Usar America/Caracas para que
# date.today() y las consultas de "hoy" coincidan con la hora local.
TZ=America/Caracas

# --- SMTP (opcional): bienvenida y restablecimiento de contraseña -----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS=true
